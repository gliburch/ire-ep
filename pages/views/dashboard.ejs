<%
  // 서버 첫 렌더에서 쓰는 표시 포맷터. 클라이언트 갱신 시에는 dashboard.js의 동일 포맷터를 쓴다.
  const formatNumber = (value) => (value ?? 0).toLocaleString("ko-KR");
  const formatDateTime = (value) => {
    if (!value) return "-";
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return "-";
    const parts = new Intl.DateTimeFormat("ko-KR", {
      timeZone: summary.timezone,
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
      hour12: true,
    }).formatToParts(date);
    const get = (type) => (parts.find((p) => p.type === type) || {}).value || "";
    return `${get("year")}-${get("month")}-${get("day")} ${get("dayPeriod")} ${get("hour").padStart(2, "0")}:${get("minute")}`;
  };
  const epPrimary = summary.epFiles[0];
  const epExcluded = summary.epFiles.find((f) => f.label === "중복제외");
  // 비교용으로 늘 열어보는 경쟁사 EP. 고정값이라 템플릿에 둔다
  const MODETOUR_EP_URL = "https://staticservice.modetour.com/onbp/naver_ep/6352_naver_ep.txt";
%>
<!DOCTYPE html>
<html lang="ko" class="md:h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>EP 수집 현황 대시보드</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brand: { DEFAULT: "#3182F6", strong: "#1B64DA", weak: "#E8F3FF" },
              ink: { DEFAULT: "#191F28", sub: "#4E5968", mute: "#8B95A1" },
              line: { DEFAULT: "#F2F4F6", strong: "#E5E8EB" },
              canvas: "#F9FAFB",
              positive: "#00A05B",
              negative: "#F04452",
            },
            fontFamily: {
              sans: ["Pretendard Variable", "Pretendard", "system-ui", "sans-serif"],
            },
            boxShadow: {
              card: "0 1px 2px rgba(0, 0, 0, 0.04), 0 4px 16px rgba(0, 0, 0, 0.04)",
            },
          },
        },
      };
    </script>
    <style type="text/tailwindcss">
      @layer utilities {
        .scrollbar-slim::-webkit-scrollbar { width: 6px; height: 6px; }
        .scrollbar-slim::-webkit-scrollbar-thumb { background: #D1D6DB; border-radius: 9999px; }
        .scrollbar-slim::-webkit-scrollbar-track { background: transparent; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
      }
      input[type="date"]::-webkit-datetime-edit-year-field,
      input[type="date"]::-webkit-datetime-edit-month-field,
      input[type="date"]::-webkit-datetime-edit-day-field,
      input[type="date"]::-webkit-datetime-edit-text { color: #6B7684; }
    </style>
  </head>
  <body class="bg-canvas font-sans text-ink antialiased md:h-full">
    <div class="flex flex-col md:h-full">
      <!-- 개괄 정보: 목록에 자리를 내주려고 두 줄로 압축해 둔다 -->
      <header class="shrink-0 border-b border-line bg-white px-4 py-2.5 md:px-6 md:py-4">
        <div class="mx-auto flex w-full max-w-[1440px] flex-col gap-1.5 md:gap-2.5">
          <!-- 1행: 타이틀 · 핵심 수치 · 새로고침 -->
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
            <h1 class="text-[18px] font-bold leading-tight tracking-tight md:text-[20px]">EP 수집 현황</h1>
            <p class="hidden text-[12px] text-ink-mute sm:block">
              <%= summary.timezone %> · <span data-field="generatedAt"><%= formatDateTime(summary.generatedAt) %></span>
            </p>
            <div class="ml-auto flex items-center gap-1.5">
              <span class="inline-flex items-baseline gap-1 whitespace-nowrap rounded-lg bg-canvas px-2.5 py-1.5">
                <span class="text-[12px] text-ink-mute">전체</span>
                <span class="text-[14px] font-bold tabular-nums" data-field="counts.products"><%= formatNumber(summary.counts.products) %></span>
              </span>
              <span class="hidden items-baseline gap-1 whitespace-nowrap rounded-lg bg-canvas px-2.5 py-1.5 sm:inline-flex">
                <span class="text-[12px] text-ink-mute">EP 보유</span>
                <span class="text-[14px] font-bold tabular-nums" data-field="counts.productsWithEp"><%= formatNumber(summary.counts.productsWithEp) %></span>
              </span>
              <span class="inline-flex items-baseline gap-1 whitespace-nowrap rounded-lg bg-brand-weak px-2.5 py-1.5">
                <span class="text-[12px] text-brand-strong">노출 대상</span>
                <span class="text-[14px] font-bold tabular-nums text-brand-strong" data-field="counts.epCandidates"><%= formatNumber(summary.counts.epCandidates) %></span>
              </span>
              <button
                type="button"
                data-action="refresh-summary"
                class="shrink-0 rounded-lg bg-line px-3 py-1.5 text-[12px] font-semibold text-ink-sub transition hover:bg-line-strong active:scale-[0.98]"
              >
                새로고침
              </button>
            </div>
          </div>

          <!-- 2행: 콜렉션 건수 · 최근 크론. 보조 정보라 한 줄 텍스트로 눕힌다 -->
          <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[12px] text-ink-mute">
            <% const collectionCounts = [
              { label: "product", field: "products", value: summary.counts.products },
              { label: "productMaster", field: "productMasters", value: summary.counts.productMasters },
              { label: "package", field: "packages", value: summary.counts.packages },
            ]; %>
            <% collectionCounts.forEach((item) => { %>
              <span class="inline-flex items-baseline gap-1 whitespace-nowrap">
                <span class="font-mono"><%= item.label %></span>
                <span class="font-bold tabular-nums text-ink-sub" data-field="counts.<%= item.field %>"><%= formatNumber(item.value) %></span>
              </span>
            <% }) %>

            <span aria-hidden="true" class="text-line-strong">|</span>
            <% if (summary.latestCronJob) { %>
              <span class="whitespace-nowrap">
                최근 크론
                <span class="font-semibold text-ink-sub"><%= formatDateTime(summary.latestCronJob.ranAt) %></span>
                <% if (summary.latestCronJob.startNo) { %>
                  (<%= formatNumber(summary.latestCronJob.startNo) %>~<%= formatNumber(summary.latestCronJob.lastNo) %>)
                <% } %>
              </span>
            <% } else { %>
              <span class="whitespace-nowrap">최근 크론 <span class="font-semibold text-ink-sub">기록 없음</span></span>
            <% } %>
            <span class="whitespace-nowrap">최근 등록 <span class="font-semibold text-ink-sub"><%= formatDateTime(summary.latestCollectedAt) %></span></span>
          </div>

          <!-- 3행: EP 주소. 링크로 바로 열 수 있게만 둔다 -->
          <div class="flex flex-col gap-1.5 text-[12px] text-ink-mute">
            <div class="flex min-w-0 items-center gap-x-2">
              <span class="shrink-0 font-semibold text-ink-sub">이레투어</span>
              <% if (epPrimary.url) { %>
                <a
                  href="<%= epPrimary.url %>"
                  target="_blank"
                  rel="noreferrer"
                  class="truncate font-semibold text-brand hover:text-brand-strong hover:underline"
                ><%= epPrimary.url %></a>
              <% } else { %>
                <span class="font-semibold text-ink-mute">FTP_BASE_URL 미설정</span>
              <% } %>
            </div>

            <% if (epExcluded && epExcluded.url) { %>
              <div class="flex min-w-0 items-center gap-x-2">
                <span class="shrink-0 font-semibold text-ink-sub">중복제외</span>
                <a
                  href="<%= epExcluded.url %>"
                  target="_blank"
                  rel="noreferrer"
                  class="truncate font-semibold text-brand hover:text-brand-strong hover:underline"
                ><%= epExcluded.url %></a>
              </div>
            <% } %>

            <div class="flex min-w-0 items-center gap-x-2">
              <span class="shrink-0 font-semibold text-ink-sub">모두투어</span>
              <a
                href="<%= MODETOUR_EP_URL %>"
                target="_blank"
                rel="noreferrer"
                class="truncate font-semibold text-brand hover:text-brand-strong hover:underline"
              ><%= MODETOUR_EP_URL %></a>
            </div>

          </div>
        </div>
      </header>

      <!-- 모바일 전환 탭 -->
      <nav class="sticky top-0 z-20 shrink-0 border-b border-line bg-white/95 px-4 backdrop-blur md:hidden">
        <div class="flex gap-1 py-1.5" role="tablist">
          <button
            type="button"
            role="tab"
            data-tab="created"
            aria-selected="true"
            class="flex-1 rounded-xl px-3 py-2 text-[14px] font-semibold transition aria-selected:bg-brand-weak aria-selected:text-brand-strong text-ink-mute"
          >
            최근 수집
          </button>
          <button
            type="button"
            role="tab"
            data-tab="updated"
            aria-selected="false"
            class="flex-1 rounded-xl px-3 py-2 text-[14px] font-semibold transition aria-selected:bg-brand-weak aria-selected:text-brand-strong text-ink-mute"
          >
            최근 업데이트
          </button>
        </div>
      </nav>

      <!-- 목록 영역: 데스크톱 반반 분할 -->
      <main class="mx-auto flex w-full max-w-[1440px] flex-col gap-0 p-0 md:min-h-0 md:flex-1 md:flex-row md:gap-4 md:p-4">
        <%
          const panels = [
            { key: "created", title: "최근 수집", caption: "createdAt 기준 최신순", dateLabel: "수집일" },
            { key: "updated", title: "최근 업데이트", caption: "수정·삭제 기록 최신순", dateLabel: "변경일", table: true },
          ];
        %>
        <% panels.forEach((panel, index) => { %>
          <section
            data-panel="<%= panel.key %>"
            class="flex w-full flex-col bg-white md:min-h-0 md:w-1/2 md:flex-1 md:rounded-2xl md:border md:border-line md:shadow-card <%= index === 1 ? 'hidden md:flex' : '' %>"
          >
            <!-- 패널 헤더 -->
            <div class="flex shrink-0 flex-wrap items-center gap-x-3 gap-y-2 border-b border-line px-4 py-2 md:py-3">
              <div class="mr-auto">
                <h2 class="text-[16px] font-bold"><%= panel.title %></h2>
                <p class="text-[12px] text-ink-mute">
                  <span data-field="total">0</span>건 · <%= panel.caption %>
                </p>
              </div>
              <label class="flex items-center gap-2">
                <span class="sr-only"><%= panel.dateLabel %> 필터</span>
                <input
                  type="date"
                  data-role="date"
                  class="h-9 rounded-xl border border-line-strong bg-canvas px-2.5 text-[13px] font-medium text-ink-sub outline-none transition focus:border-brand focus:bg-white focus:ring-2 focus:ring-brand/20"
                />
              </label>
              <button
                type="button"
                data-action="clear-date"
                class="hidden h-9 rounded-xl bg-line px-3 text-[13px] font-semibold text-ink-sub transition hover:bg-line-strong"
              >
                초기화
              </button>
            </div>

            <!-- 패널 바디 (스크롤) -->
            <% if (panel.table) { %>
              <!-- 표는 컬럼이 많아 가로로도 스크롤된다 -->
              <div data-role="body" class="overflow-x-auto md:min-h-0 md:flex-1 md:overflow-auto md:overscroll-contain md:scrollbar-slim">
                <table class="w-full min-w-[640px] border-collapse text-left text-[12px]">
                  <thead class="sticky top-0 z-10 bg-canvas text-[11px] font-semibold text-ink-mute">
                    <tr>
                      <th class="whitespace-nowrap px-3 py-2 font-semibold">시각</th>
                      <th class="whitespace-nowrap px-2 py-2 font-semibold">구분</th>
                      <th class="whitespace-nowrap px-2 py-2 font-semibold">상품번호</th>
                      <th class="whitespace-nowrap px-2 py-2 font-semibold">내용</th>
                      <th class="whitespace-nowrap px-3 py-2 font-semibold">changes</th>
                    </tr>
                  </thead>
                  <tbody data-role="list" class="divide-y divide-line align-top"></tbody>
                </table>
                <p data-role="state" class="px-4 py-10 text-center text-[13px] text-ink-mute">불러오는 중…</p>
              </div>
            <% } else { %>
              <div data-role="body" class="md:min-h-0 md:flex-1 md:overflow-y-auto md:overscroll-contain md:scrollbar-slim">
                <div data-role="list" class="divide-y divide-line"></div>
                <p data-role="state" class="px-4 py-10 text-center text-[13px] text-ink-mute">불러오는 중…</p>
              </div>
            <% } %>

            <!-- 패널 푸터 (페이지네이션) -->
            <div class="flex shrink-0 items-center justify-between gap-2 border-t border-line px-4 py-3">
              <button
                type="button"
                data-action="prev"
                class="h-9 rounded-xl bg-line px-4 text-[13px] font-semibold text-ink-sub transition hover:bg-line-strong disabled:cursor-not-allowed disabled:opacity-40"
              >
                이전
              </button>
              <p class="text-[13px] font-semibold tabular-nums text-ink-sub">
                <span data-field="page">1</span>
                <span class="text-ink-mute">/</span>
                <span data-field="totalPages">1</span>
              </p>
              <button
                type="button"
                data-action="next"
                class="h-9 rounded-xl bg-brand px-4 text-[13px] font-semibold text-white transition hover:bg-brand-strong disabled:cursor-not-allowed disabled:bg-line disabled:text-ink-mute"
              >
                다음
              </button>
            </div>
          </section>
        <% }) %>
      </main>
    </div>

    <div
      data-role="toast"
      class="pointer-events-none fixed bottom-6 left-1/2 z-50 -translate-x-1/2 rounded-xl bg-ink px-4 py-2.5 text-[13px] font-semibold text-white opacity-0 transition-opacity duration-200"
    ></div>

    <script>
      (function () {
        "use strict";

        var TIMEZONE = "<%= summary.timezone %>";
        var PAGE_SIZE = 20;

        function formatNumber(value) {
          return Number(value || 0).toLocaleString("ko-KR");
        }

        function formatDateTime(value) {
          if (!value) return "-";
          var date = new Date(value);
          if (isNaN(date.getTime())) return "-";
          var parts = new Intl.DateTimeFormat("ko-KR", {
            timeZone: TIMEZONE,
            year: "numeric",
            month: "2-digit",
            day: "2-digit",
            hour: "2-digit",
            minute: "2-digit",
            hour12: true,
          }).formatToParts(date);
          var get = function (type) {
            var hit = parts.find(function (p) { return p.type === type; });
            return hit ? hit.value : "";
          };
          return get("year") + "-" + get("month") + "-" + get("day") + " " + get("dayPeriod") + " " + get("hour").padStart(2, "0") + ":" + get("minute");
        }

        function formatDate(value) {
          if (!value) return "-";
          var date = new Date(value);
          if (isNaN(date.getTime())) return "-";
          return date.toLocaleDateString("ko-KR", {
            timeZone: TIMEZONE,
            year: "2-digit",
            month: "2-digit",
            day: "2-digit",
          });
        }

        function formatPrice(value) {
          var numeric = Number(String(value).replace(/[^0-9.-]/g, ""));
          if (!value || isNaN(numeric) || numeric === 0) return "";
          return formatNumber(numeric) + "원";
        }

        function escapeHtml(value) {
          return String(value == null ? "" : value).replace(/[&<>"']/g, function (char) {
            return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[char];
          });
        }

        var toastElement = document.querySelector('[data-role="toast"]');
        var toastTimer = null;

        function showToast(message) {
          if (!toastElement) return;
          toastElement.textContent = message;
          toastElement.classList.remove("opacity-0");
          toastElement.classList.add("opacity-100");
          clearTimeout(toastTimer);
          toastTimer = setTimeout(function () {
            toastElement.classList.remove("opacity-100");
            toastElement.classList.add("opacity-0");
          }, 1800);
        }

        /**
         * 목록 한 건의 카드 마크업.
         * - 기준 시각(수집/업데이트)은 패널에 따라 다른 필드를 강조한다
         */
        function renderItem(item, sortKey) {
          var primaryLabel = sortKey === "updated" ? "업데이트" : "수집";
          var primaryAt = sortKey === "updated" ? item.updatedAt : item.createdAt;
          var price = formatPrice(item.price);
          var thumbnail = item.imageLink
            ? '<img src="' +
              escapeHtml(item.imageLink) +
              '" alt="" loading="lazy" class="h-14 w-14 shrink-0 rounded-xl bg-canvas object-cover" onerror="this.remove()" />'
            : '<div class="h-14 w-14 shrink-0 rounded-xl bg-canvas"></div>';

          var titleHtml =
            escapeHtml(item.title) +
            (item.departureSuffix
              ? ' <span class="font-normal text-ink-mute">. ' + escapeHtml(item.departureSuffix) + "</span>"
              : "");

          var titleNode = item.link
            ? '<a href="' +
              escapeHtml(item.link) +
              '" target="_blank" rel="noreferrer" class="line-clamp-3 text-[14px] font-semibold leading-snug text-ink hover:text-brand hover:underline">' +
              titleHtml +
              "</a>"
            : '<p class="line-clamp-3 text-[14px] font-semibold leading-snug text-ink">' + titleHtml + "</p>";

          return (
            '<article class="flex gap-3 px-4 py-3 transition hover:bg-canvas">' +
            thumbnail +
            '<div class="min-w-0 flex-1">' +
            titleNode +
            '<div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-0.5 text-[12px] text-ink-mute">' +
            '<span class="font-medium text-ink-sub tabular-nums">#' +
            escapeHtml(item.productNo) +
            "</span>" +
            (price ? '<span class="font-semibold text-ink-sub tabular-nums">' + price + "</span>" : "") +
            "</div>" +
            '<p class="mt-0.5 text-[12px] tabular-nums text-ink-mute">' +
            primaryLabel +
            " " +
            formatDateTime(primaryAt) +
            (item.verifiedAt ? " · 검증 " + formatDateTime(item.verifiedAt) : "") +
            "</p>" +
            "</div>" +
            "</article>"
          );
        }

        // 구분 배지 색. 삭제는 되돌릴 수 없으니 눈에 띄게 둔다.
        var ACTION_STYLES = {
          updated: { label: "수정", className: "bg-brand-weak text-brand-strong" },
          deleted: { label: "삭제", className: "bg-rose-100 text-rose-700" },
        };

        // 상품 상세는 productNo로 바로 열린다.
        // 마스터/패키지는 주소 규칙이 달라 링크를 걸지 않는다.
        var PRODUCT_DETAIL_BASE = "https://ire.modetour.co.kr/package/";

        /**
         * 변경 기록 한 줄의 표 마크업.
         * - changes는 가공하지 않고 JSON 그대로 노출한다
         * - 상품번호는 실제 판매 페이지로 바로 확인할 수 있게 새 창 링크를 건다
         */
        function renderChangeRow(item) {
          var action = ACTION_STYLES[item.action] || { label: item.action, className: "bg-line text-ink-sub" };
          var changesJson = item.changes ? JSON.stringify(item.changes) : "";
          var refLabel = "#" + escapeHtml(item.refKey);
          var refNode =
            item.entity === "product"
              ? '<a href="' +
                PRODUCT_DETAIL_BASE +
                encodeURIComponent(item.refKey) +
                '" target="_blank" rel="noreferrer" class="text-brand hover:text-brand-strong hover:underline">' +
                refLabel +
                "</a>"
              : refLabel;

          return (
            '<tr class="transition hover:bg-canvas">' +
            '<td class="whitespace-nowrap px-3 py-2 tabular-nums text-ink-mute">' +
            formatDateTime(item.createdAt) +
            "</td>" +
            '<td class="whitespace-nowrap px-2 py-2">' +
            '<span class="inline-flex rounded-lg px-2 py-0.5 text-[11px] font-semibold ' +
            action.className +
            '">' +
            escapeHtml(action.label) +
            "</span>" +
            "</td>" +
            '<td class="whitespace-nowrap px-2 py-2 font-medium tabular-nums text-ink-sub">' +
            refNode +
            "</td>" +
            '<td class="px-2 py-2 text-ink">' +
            escapeHtml(item.note) +
            "</td>" +
            '<td class="px-3 py-2">' +
            (changesJson
              ? '<code class="block max-w-[320px] break-all font-mono text-[11px] leading-relaxed text-ink-mute">' +
                escapeHtml(changesJson) +
                "</code>"
              : '<span class="text-ink-mute">-</span>') +
            "</td>" +
            "</tr>"
          );
        }

        /**
         * 목록 패널 하나를 제어한다. (조회 / 날짜 필터 / 페이지네이션)
         */
        function createPanel(section) {
          var sortKey = section.dataset.panel === "updated" ? "updated" : "created";
          // 업데이트 패널은 Product가 아니라 변경 기록(changeLogs)을 본다.
          // 삭제된 상품은 Product에 남지 않아 변경 내역을 여기서만 볼 수 있다.
          var isChangeLog = sortKey === "updated";
          var listElement = section.querySelector('[data-role="list"]');
          var stateElement = section.querySelector('[data-role="state"]');
          var bodyElement = section.querySelector('[data-role="body"]');
          var dateInput = section.querySelector('[data-role="date"]');
          var clearButton = section.querySelector('[data-action="clear-date"]');
          var prevButton = section.querySelector('[data-action="prev"]');
          var nextButton = section.querySelector('[data-action="next"]');
          var fields = {
            total: section.querySelector('[data-field="total"]'),
            page: section.querySelector('[data-field="page"]'),
            totalPages: section.querySelector('[data-field="totalPages"]'),
          };

          var page = 1;
          var requestId = 0;

          function setState(message) {
            if (!message) {
              stateElement.classList.add("hidden");
              return;
            }
            stateElement.textContent = message;
            stateElement.classList.remove("hidden");
          }

          function buildUrl() {
            var params = new URLSearchParams({
              page: String(page),
              pageSize: String(PAGE_SIZE),
            });
            if (!isChangeLog) params.set("sort", sortKey);
            if (dateInput.value) params.set("date", dateInput.value);
            return (isChangeLog ? "/http-api/dashboard/changes?" : "/http-api/dashboard/feed?") + params.toString();
          }

          async function load() {
            var currentRequest = ++requestId;
            prevButton.disabled = true;
            nextButton.disabled = true;
            if (!listElement.childElementCount) setState("불러오는 중…");

            try {
              var response = await fetch(buildUrl(), { headers: { Accept: "application/json" } });
              if (!response.ok) throw new Error("HTTP " + response.status);
              var data = await response.json();

              // 느린 응답이 뒤늦게 도착해 최신 결과를 덮어쓰지 않도록 버린다.
              if (currentRequest !== requestId) return;

              page = data.page;
              fields.total.textContent = formatNumber(data.total);
              fields.page.textContent = formatNumber(data.page);
              fields.totalPages.textContent = formatNumber(data.totalPages);

              listElement.innerHTML = data.items
                .map(function (item) {
                  return isChangeLog ? renderChangeRow(item) : renderItem(item, sortKey);
                })
                .join("");

              setState(
                data.items.length
                  ? ""
                  : isChangeLog
                    ? "조건에 맞는 변경 기록이 없습니다."
                    : "조건에 맞는 상품이 없습니다.",
              );
              bodyElement.scrollTop = 0;

              prevButton.disabled = data.page <= 1;
              nextButton.disabled = data.page >= data.totalPages;
            } catch (error) {
              if (currentRequest !== requestId) return;
              listElement.innerHTML = "";
              setState(
                (isChangeLog ? "변경 기록을" : "목록을") +
                  " 불러오지 못했습니다. (" + error.message + ")",
              );
              prevButton.disabled = page <= 1;
              nextButton.disabled = false;
            }
          }

          dateInput.addEventListener("change", function () {
            page = 1;
            clearButton.classList.toggle("hidden", !dateInput.value);
            load();
          });

          clearButton.addEventListener("click", function () {
            dateInput.value = "";
            clearButton.classList.add("hidden");
            page = 1;
            load();
          });

          prevButton.addEventListener("click", function () {
            if (page <= 1) return;
            page -= 1;
            load();
          });

          nextButton.addEventListener("click", function () {
            page += 1;
            load();
          });

          load();

          return { reload: function () { page = 1; load(); } };
        }

        var panels = Array.prototype.map.call(document.querySelectorAll("[data-panel]"), createPanel);

        // 모바일 탭 전환
        var tabButtons = document.querySelectorAll("[data-tab]");
        Array.prototype.forEach.call(tabButtons, function (button) {
          button.addEventListener("click", function () {
            Array.prototype.forEach.call(tabButtons, function (other) {
              other.setAttribute("aria-selected", String(other === button));
            });
            document.querySelectorAll("[data-panel]").forEach(function (section) {
              var active = section.dataset.panel === button.dataset.tab;
              section.classList.toggle("hidden", !active);
              section.classList.toggle("md:flex", true);
            });
          });
        });

        // 개괄 정보 새로고침
        var refreshButton = document.querySelector('[data-action="refresh-summary"]');
        if (refreshButton) {
          refreshButton.addEventListener("click", async function () {
            refreshButton.disabled = true;
            refreshButton.textContent = "갱신 중…";

            try {
              var response = await fetch("/http-api/dashboard/summary", { headers: { Accept: "application/json" } });
              if (!response.ok) throw new Error("HTTP " + response.status);
              var summary = await response.json();

              document.querySelectorAll("[data-field]").forEach(function (element) {
                var path = element.dataset.field;
                if (path === "generatedAt") {
                  element.textContent = formatDateTime(summary.generatedAt);
                  return;
                }
                if (path.indexOf("counts.") !== 0) return;
                element.textContent = formatNumber(summary.counts[path.slice("counts.".length)]);
              });

              panels.forEach(function (panel) {
                panel.reload();
              });
              showToast("최신 현황으로 갱신했어요");
            } catch (error) {
              showToast("갱신에 실패했어요");
            } finally {
              refreshButton.disabled = false;
              refreshButton.textContent = "새로고침";
            }
          });
        }
      })();
    </script>
  </body>
</html>
