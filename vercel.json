{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/collect",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/collect",
      "schedule": "5 4 * * *"
    },
    {
      "path": "/api/cron/collect",
      "schedule": "10 4 * * *"
    },
    {
      "path": "/api/cron/collect",
      "schedule": "15 4 * * *"
    },
    {
      "path": "/api/cron/collect",
      "schedule": "20 4 * * *"
    }
  ],
  "functions": {
    "api/cron/collect.js": {
      "maxDuration": 300
    }
  }
}
